rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    function isMember(tripId) {
      return signedIn()
        && myEmail() in get(/databases/$(database)/documents/trips/$(tripId)).data.memberEmails;
    }

    match /trips/{tripId} {
      // Lecture / modification / suppression réservées aux membres du voyage
      allow read, update, delete: if signedIn() && myEmail() in resource.data.memberEmails;
      // Création : le créateur doit faire partie des membres
      allow create: if signedIn() && myEmail() in request.resource.data.memberEmails;

      match /{sub=**} {
        allow read, write: if isMember(tripId);
      }
    }
  }
}
